# Copy to local/.env (never committed). Docker Compose reads it for the ${…} values in
# compose.yaml. Everything here is optional: the stack runs without it.

# Workspaces' own AI keys (BYOK) are encrypted with this. `openssl rand -base64 32`.
AI_KEYS_MASTER=

# Managed mode: e.g. AI_MANAGED_CHAT=anthropic:model-a,anthropic:model-b
AI_MANAGED_CHAT=
AI_MANAGED_KEY=

# Paystack test mode (a sk_test_ key and plan codes from the Paystack dashboard).
# Empty → the labelled test checkout.
PAYSTACK_SECRET_KEY=
PAYSTACK_PLAN_PRO_MONTHLY=
PAYSTACK_PLAN_BUSINESS_MONTHLY=
